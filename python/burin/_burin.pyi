"""Types for the compiled core. Records and GeoJSON cross the boundary as _JSON: a ``str``, or any
object ``json.dumps`` accepts (NaN and infinity refused)."""
from collections.abc import Iterable, Sequence
from typing import Any, Final, TypedDict, final

import numpy as np
from numpy.typing import NDArray

__all__ = [
    "Profile",
    "Tree",
    "Index",
    "Fingerprint",
    "Proof",
    "Transcript",
    "InvalidProof",
    "polyfill",
    "fingerprint_polygon",
    "verify_opening",
    "verify_setop",
    "verify_relation",
    "opening_statement",
    "_ticks",
    "_tick_starts",
    "_interval_cells",
    "_coarse_cells",
    "_cell_ticks",
    "_allen",
    "cell_area_m2",
    "cells_geojson",
    "suid_to_cid",
    "cid_to_suid",
    "position",
    "cell_at",
    "subzone_index",
    "subzone_at",
    "subzones",
    "neighbours",
    "halo_index",
    "_cells_from_lonlat",
    "_cells_to_lonlat",
    "_cell_boundaries",
    "_cell_neighbours",
    "raster_index",
    "raster_cells",
    "OGC_RHEALPIX",
    "BURIN_1",
    "MAX_RESOLUTION",
    "__version__",
]

__version__: Final[str]
MAX_RESOLUTION: Final[int]
OGC_RHEALPIX: Final[Profile]
BURIN_1: Final[Profile]

_JSON = Any
_CellIds = Iterable[int] | NDArray[np.uint64]

class _Divergence(TypedDict):
    cid: int
    suid: str
    hash_a: str
    hash_b: str

class _Hit(TypedDict):
    key: str
    root: str
    relation: str
    fraction_of_query: float
    fraction_of_item: float
    shared_cells: int

class _Neighbours(TypedDict):
    up: int
    right: int
    down: int
    left: int

@final
class Profile:
    def __new__(
        cls,
        hash: str = "sha256",
        aperture: int = 9,
        n_base: int = 6,
        lon_0_udeg: int = 50_000_000,
        north_square: int = 0,
        south_square: int = 0,
        a_um: int = 6_378_137_000_000,
        inv_f_nano: int = 298_257_223_563,
        tick_us: int = 1,
        epoch_us: int = 0,
    ) -> Profile: ...
    @staticmethod
    def ogc() -> Profile: ...
    @staticmethod
    def burin_1() -> Profile: ...
    @staticmethod
    def from_dict(d: _JSON) -> Profile: ...
    def to_dict(self) -> dict[str, Any]: ...
    def id_hex(self) -> str: ...
    def describe(self) -> str: ...
    def area_m2(self, level: int) -> float: ...
    @property
    def hash(self) -> str: ...
    @property
    def lon_0(self) -> float: ...
    @property
    def aperture(self) -> int: ...
    @property
    def n_base(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...

class InvalidProof(ValueError): ...

@final
class Proof:
    @staticmethod
    def from_json(obj: _JSON) -> Proof: ...
    def to_json(self) -> dict[str, Any]: ...
    @property
    def claimed_cell(self) -> int | None: ...
    @property
    def claimed_covered(self) -> bool | None: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Transcript:
    @staticmethod
    def from_json(obj: _JSON) -> Transcript: ...
    def to_json(self) -> dict[str, Any]: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Fingerprint:
    @staticmethod
    def parse(text: str, profiles: Sequence[Profile] | None = None) -> Fingerprint: ...
    @property
    def profile(self) -> Profile: ...
    @property
    def axis(self) -> str: ...
    @property
    def depth(self) -> int: ...
    @property
    def root_hex(self) -> str: ...
    def check_cell(self, proof: Proof | _JSON, cell: int) -> bool: ...
    def check_point(self, proof: Proof | _JSON, lon: float, lat: float) -> bool: ...
    def check_instant(self, proof: Proof | _JSON, instant: Any) -> bool: ...
    def check_relation(self, relation: str, other: Fingerprint, transcript: Transcript | _JSON | None = None) -> bool: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Tree:
    @staticmethod
    def from_cells(cids: _CellIds, depth: int, profile: Profile | None = None) -> Tree: ...
    @staticmethod
    def from_geojson(geojson: _JSON, resolution: int, profile: Profile | None = None) -> Tree: ...
    @staticmethod
    def from_intervals(intervals: Sequence[tuple[int, int]], profile: Profile | None = None) -> Tree: ...
    @staticmethod
    def from_time_cells(cids: _CellIds, profile: Profile | None = None) -> Tree: ...
    @staticmethod
    def from_raster(data: bytes, depth: int, profile: Profile | None = None) -> Tree: ...
    @staticmethod
    def from_dggs_json(
        doc: _JSON, field: str | None = None, depth: int | None = None, nonzero: bool = False, profile: Profile | None = None
    ) -> Tree: ...
    @property
    def axis(self) -> str: ...
    @property
    def root_hex(self) -> str: ...
    @property
    def depth(self) -> int: ...
    @property
    def profile(self) -> Profile: ...
    def cells(self) -> list[int]: ...
    def leaves(self) -> list[int]: ...
    def leaf_count(self) -> int: ...
    def is_empty(self) -> bool: ...
    def covers(self, cid: int) -> bool: ...
    def raster(self) -> bytes: ...
    def to_dggs_json(self, zone: int, field: str = "coverage") -> dict[str, Any]: ...
    def union(self, other: Tree) -> Tree: ...
    def intersect(self, other: Tree) -> Tree: ...
    def difference(self, other: Tree) -> Tree: ...
    def divergence(self, other: Tree) -> list[_Divergence]: ...
    def open(self, cid: int) -> dict[str, Any] | None: ...
    def prove(self, other: Tree, op: str) -> dict[str, Any]: ...
    @property
    def fingerprint(self) -> Fingerprint: ...
    def prove_cell(self, cid: int) -> Proof: ...
    def prove_point(self, lon: float, lat: float) -> Proof: ...
    def prove_instant(self, instant: Any) -> Proof: ...
    def prove_relation(self, other: Tree, relation: str) -> Transcript | None: ...
    def holds(self, other: Tree, relation: str) -> bool: ...
    def relation_evidence(self, other: Tree, relation: str) -> dict[str, Any] | None: ...
    def geojson(self, n: int = 3) -> dict[str, Any]: ...
    def __eq__(self, other: object, /) -> bool: ...

@final
class Index:
    def __new__(cls) -> Index: ...
    def add(self, key: str, tree: Tree) -> None: ...
    def __len__(self) -> int: ...
    @property
    def distinct_roots(self) -> int: ...
    def query(self, tree: Tree) -> list[_Hit]: ...
    def attention(self, level: int) -> dict[int, int]: ...
    def roots(self) -> list[tuple[str, str]]: ...

def polyfill(geojson: _JSON, resolution: int, profile: Profile | None = None) -> list[int]: ...
def fingerprint_polygon(geojson: _JSON, resolution: int, profile: Profile | None = None) -> str: ...
def verify_opening(record: _JSON) -> bool: ...
def verify_setop(proof: _JSON) -> bool: ...
def opening_statement(record: _JSON) -> tuple[int, bool]: ...
def verify_relation(relation: str, root_x: str, root_y: str, proof: _JSON | None = None) -> bool: ...
def cell_area_m2(level: int, profile: Profile | None = None) -> float: ...
def cells_geojson(cids: Sequence[int], profile: Profile | None = None, n: int = 3) -> dict[str, Any]: ...
def suid_to_cid(suid: str) -> int: ...
def cid_to_suid(cid: int) -> str: ...
def position(cid: int, profile: Profile | None = None) -> tuple[int, int, int, int]: ...
def cell_at(base: int, level: int, row: int, col: int, profile: Profile | None = None) -> int: ...
def subzone_index(ancestor: int, cid: int, profile: Profile | None = None) -> int: ...
def subzone_at(ancestor: int, depth: int, index: int, profile: Profile | None = None) -> int: ...
def subzones(ancestor: int, depth: int, profile: Profile | None = None) -> list[int]: ...
def neighbours(cid: int, profile: Profile | None = None) -> _Neighbours: ...
def raster_index(cids: Sequence[int], profile: Profile | None = None) -> bytes: ...
def raster_cells(level: int, profile: Profile | None = None) -> bytes: ...
def halo_index(level: int, width: int = 1, profile: Profile | None = None) -> bytes: ...
def _cells_from_lonlat(
    lon: NDArray[np.float64], lat: NDArray[np.float64], level: int, profile: Profile | None = None, nthreads: int = 0
) -> NDArray[np.uint64]: ...
def _cells_to_lonlat(
    cids: NDArray[np.uint64], profile: Profile | None = None, nthreads: int = 0
) -> tuple[NDArray[np.float64], NDArray[np.float64]]: ...
def _cell_boundaries(
    cids: NDArray[np.uint64], n: int = 5, profile: Profile | None = None, nthreads: int = 0
) -> tuple[NDArray[np.float64], NDArray[np.int64]]: ...
def _cell_neighbours(cids: NDArray[np.uint64], profile: Profile | None = None, nthreads: int = 0) -> NDArray[np.uint64]: ...
def _ticks(posix_us: NDArray[np.int64], profile: Profile | None = None) -> NDArray[np.uint64]: ...
def _tick_starts(ticks: NDArray[np.uint64], profile: Profile | None = None) -> NDArray[np.int64]: ...
def _interval_cells(lo: int, hi: int) -> list[int]: ...
def _coarse_cells(lo: int, hi: int, level: int) -> list[int]: ...
def _cell_ticks(cids: NDArray[np.uint64]) -> tuple[NDArray[np.uint64], NDArray[np.uint64]]: ...
def _allen(a: tuple[int, int], b: tuple[int, int]) -> str: ...
